<!-- ════════════════════════════
  WHO I AM
════════════════════════════ -->
<section id="section-who">
  <div class="who-3d-title" aria-hidden="true">WHO I AM &nbsp;&nbsp; WHO I AM &nbsp;&nbsp; WHO I AM &nbsp;&nbsp; WHO I AM &nbsp;&nbsp;</div>
  <div class="s-wrap" style="padding-top:6rem;">
    <div class="s-tag reveal">
      <span class="n">01</span><span>— Who I Am</span><span class="ln"></span>
    </div>
    <div class="who-grid reveal">
      <div class="who-left">
        <div>
          <p class="big-quote">My goal is simple — create digital work that feels premium, intuitive, and meaningful.</p>
        </div>
        <div class="who-stats">
          <div class="who-stat"><div class="who-stat-n">09+</div><div class="who-stat-l">Projects</div></div>
          <div class="who-stat"><div class="who-stat-n">2+</div><div class="who-stat-l">Years Exp.</div></div>
          <div class="who-stat"><div class="who-stat-n">5+</div><div class="who-stat-l">Tech Stacks</div></div>
          <div class="who-stat"><div class="who-stat-n">∞</div><div class="who-stat-l">Curiosity</div></div>
        </div>
      </div>
      <div class="who-right">
        <div class="para-list">
          <div class="para-item">
            <span class="para-label">Origin</span>
            <p>I'm a <strong>creative web designer and developer</strong> who started this journey out of pure curiosity and turned it into a craft. Every project is an opportunity to push the boundaries of what's possible on the web.</p>
          </div>
          <div class="para-item">
            <span class="para-label">Philosophy</span>
            <p>I believe great design is <strong>invisible</strong>. When everything works perfectly, users don't notice the design — they just enjoy the experience. That philosophy drives every decision I make, from typography to interaction patterns.</p>
          </div>
          <div class="para-item">
            <span class="para-label">Drive</span>
            <p>Beyond the screen, I'm constantly exploring new technologies, studying great design, and building things just to see if I can. <strong>The web is endlessly interesting to me</strong> — and that excitement shows up in my work.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════
  SKILLS
════════════════════════════ -->
<section id="section-skills">
  <div id="skills-canvas-wrap"><canvas id="skills-canvas"></canvas></div>
  <div class="s-wrap skills-content">
    <div class="s-tag reveal">
      <span class="n">02</span><span>— Core Skills</span><span class="ln"></span>
    </div>
    <div class="skills-3grid reveal">
      <div class="sk-card">
        <div class="sk-n">[01]</div>
        <div class="sk-icon">💻</div>
