<!-- ════════════════════════════
  HERO — FULL 3D CANVAS
════════════════════════════ -->
<section id="hero">
  <canvas id="hero-canvas"></canvas>
  <div class="hero-content">
    <div class="hero-content-inner">
      <div class="hero-left-text">
