<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>About — Vivek</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cabinet+Grotesk:wght@400;500;700;900&family=DM+Mono:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#04040a;--surface:#0a0a12;
  --border:rgba(255,255,255,.05);
  --accent:#b8ff57;--accent2:#5c8aff;--accent3:#ff5ca8;
  --text:#f0f0ee;--muted:#484852;--muted2:#1e1e28;
}
html{scroll-behavior:smooth;}
body{font-family:'DM Mono',monospace;background:var(--bg);color:var(--text);overflow-x:hidden;cursor:none;}

/* ── CURSOR ── */
.cursor{position:fixed;width:18px;height:18px;background:var(--accent);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:difference;transition:width .15s,height .15s;}
.cursor-ring{position:fixed;width:36px;height:36px;border:1px solid rgba(184,255,87,.3);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .3s,height .3s,border-color .3s;}
.cursor.big{width:12px;height:12px;}
.cursor-ring.big{width:54px;height:54px;border-color:var(--accent);}

/* ── GRAIN ── */
body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");pointer-events:none;z-index:9000;}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:500;display:flex;align-items:center;justify-content:space-between;padding:0 3rem;height:68px;background:rgba(4,4,10,.8);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;letter-spacing:.08em;color:var(--text);text-decoration:none;}
.nav-logo span{color:var(--accent);}
.nav-links{display:flex;gap:2.5rem;list-style:none;}
.nav-links a{color:var(--muted);text-decoration:none;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;transition:color .2s;position:relative;}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;right:0;height:1px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .3s;}
.nav-links a:hover,.nav-links a.active{color:var(--text);}
.nav-links a:hover::after,.nav-links a.active::after{transform:scaleX(1);}
.ham{display:none;flex-direction:column;gap:5px;cursor:none;}
.ham span{width:24px;height:1.5px;background:var(--text);transition:all .3s;display:block;}
.ham.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg);}
.ham.open span:nth-child(2){opacity:0;}
.ham.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg);}
.mob{position:fixed;inset:0;z-index:450;background:rgba(4,4,10,.97);backdrop-filter:blur(40px);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:2.5rem;transform:translateY(-100%);transition:transform .6s cubic-bezier(.16,1,.3,1);}
.mob.open{transform:translateY(0);}
.mob a{font-family:'Bebas Neue',sans-serif;font-size:4rem;letter-spacing:.06em;color:var(--text);text-decoration:none;transition:color .2s;}
.mob a:hover{color:var(--accent);}

/* ══════════════════════════════════
   SECTION 1: HERO — FULLSCREEN 3D
══════════════════════════════════ */
#hero{position:relative;width:100%;height:100vh;overflow:hidden;}
#hero-canvas{position:absolute;inset:0;width:100%;height:100%;}

.hero-content{
  position:absolute;inset:0;
  display:flex;align-items:flex-end;
  padding:0 3rem 5rem;
  pointer-events:none;
  z-index:2;
}
.hero-content-inner{width:100%;display:flex;justify-content:space-between;align-items:flex-end;}

.hero-left-text{opacity:0;animation:rise .9s .4s forwards;}
.hero-eyebrow{display:flex;align-items:center;gap:.8rem;font-size:.65rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);margin-bottom:1.5rem;}
.hero-eyebrow::before{content:'';width:20px;height:1px;background:var(--accent);}
.hero-name{font-family:'Bebas Neue',sans-serif;font-size:clamp(5rem,13vw,14rem);line-height:.86;letter-spacing:-.01em;}
.hero-name .dim{color:transparent;-webkit-text-stroke:1px rgba(240,240,238,.15);}
.hero-name .bright{color:var(--text);}
.hero-name .green{color:var(--accent);}

.hero-right-meta{text-align:right;opacity:0;animation:rise .8s .6s forwards;}
.hero-role{font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:1.5rem;}
.hero-tag-row{display:flex;gap:.6rem;justify-content:flex-end;flex-wrap:wrap;}
.hero-tag{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;border:1px solid var(--muted2);padding:.3rem .8rem;color:var(--muted);}

.scroll-hint{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.6rem;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);animation:bob 2.2s ease infinite;z-index:3;}
.scroll-line{width:1px;height:36px;background:linear-gradient(var(--muted),transparent);}

/* Scan line effect on hero */
#hero::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(255,255,255,.006) 3px,rgba(255,255,255,.006) 4px);pointer-events:none;z-index:3;}

/* ══════════════════════════════════
   SECTION WRAPPER
══════════════════════════════════ */
.s-wrap{position:relative;z-index:1;max-width:1440px;margin:0 auto;padding:7rem 3rem;}
.s-tag{display:flex;align-items:center;gap:1rem;font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:4rem;}
.s-tag .n{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;color:var(--accent);letter-spacing:.05em;}
.s-tag .ln{flex:1;height:1px;background:var(--border);}

/* ══════════════════════════════════
   SECTION 2: WHO I AM — 3D ROTATING TEXT + PARAGRAPHS
══════════════════════════════════ */
#section-who{background:var(--bg);border-top:1px solid var(--border);overflow:hidden;position:relative;}

/* big 3D perspective title */
.who-3d-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(6rem,18vw,20rem);
  line-height:.85; letter-spacing:-.02em;
  color:transparent; -webkit-text-stroke:1px rgba(184,255,87,.08);
  position:absolute; top:4rem; left:-2rem;
  pointer-events:none; white-space:nowrap;
  animation:slideTitle 18s linear infinite;
  z-index:0;
}
@keyframes slideTitle{from{transform:translateX(0)}to{transform:translateX(-50%)}}

.who-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:0; position:relative; z-index:1;
  border:1px solid var(--border);
}
.who-left{
  padding:4rem; border-right:1px solid var(--border);
  display:flex;flex-direction:column;justify-content:space-between;
}
.who-right{padding:4rem;}

.big-quote{
  font-family:'Cabinet Grotesk',sans-serif;
  font-weight:900;font-size:clamp(1.6rem,3vw,2.6rem);
  line-height:1.3;letter-spacing:-.03em;color:var(--text);
  margin-bottom:3rem; position:relative;
}
.big-quote::before{content:'"';position:absolute;top:-1.5rem;left:-.5rem;font-family:'Bebas Neue',sans-serif;font-size:8rem;color:rgba(184,255,87,.08);line-height:1;}

.who-stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);}
.who-stat{background:var(--bg);padding:1.6rem;transition:background .3s;}
.who-stat:hover{background:var(--surface);}
.who-stat-n{font-family:'Bebas Neue',sans-serif;font-size:2.8rem;line-height:1;color:var(--accent);}
.who-stat-l{font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:.3rem;}

.para-list{display:flex;flex-direction:column;gap:0;}
.para-item{padding:2.2rem 0;border-bottom:1px solid var(--border);}
.para-item:first-child{padding-top:0;}
.para-item:last-child{border-bottom:none;padding-bottom:0;}
.para-label{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin-bottom:.8rem;display:block;}
.para-item p{font-size:.82rem;color:var(--muted);line-height:2;}
.para-item p strong{color:var(--text);font-weight:400;}

/* ══════════════════════════════════
   SECTION 3: SKILLS — 3D CARDS WITH CANVAS
══════════════════════════════════ */
#section-skills{border-top:1px solid var(--border);background:var(--surface);overflow:hidden;position:relative;}

/* 3D skills micro-scene */
#skills-canvas-wrap{position:absolute;right:0;top:0;bottom:0;width:420px;opacity:.6;pointer-events:none;}
#skills-canvas{width:100%;height:100%;}

.skills-content{position:relative;z-index:1;}
.skills-3grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);}
.sk-card{
  background:var(--surface);padding:3rem 2.5rem;position:relative;overflow:hidden;
  transition:background .3s,transform .4s;transform-style:preserve-3d;
  cursor:none;
}
.sk-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent),transparent);transform:scaleX(0);transform-origin:center;transition:transform .5s;}
.sk-card:hover::before{transform:scaleX(1);}
.sk-card::after{content:'';position:absolute;top:-80px;right:-80px;width:250px;height:250px;background:radial-gradient(circle,rgba(184,255,87,.07),transparent 70%);opacity:0;transition:opacity .4s;pointer-events:none;}
.sk-card:hover::after{opacity:1;}
.sk-card:hover{background:rgba(255,255,255,.02);}
.sk-n{font-size:.58rem;letter-spacing:.2em;color:var(--accent);text-transform:uppercase;margin-bottom:1.8rem;}
.sk-icon{
  width:56px;height:56px;border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;font-size:1.5rem;
  margin-bottom:1.8rem;transition:border-color .3s,transform .4s;
}
.sk-card:hover .sk-icon{border-color:rgba(184,255,87,.3);transform:rotate(10deg) scale(1.1);}
.sk-card h3{font-family:'Cabinet Grotesk',sans-serif;font-weight:900;font-size:1.15rem;letter-spacing:-.02em;margin-bottom:.7rem;}
.sk-card p{font-size:.77rem;color:var(--muted);line-height:1.85;margin-bottom:1.8rem;flex:1;}

/* skill bar */
.sk-bar-wrap{display:flex;flex-direction:column;gap:.6rem;}
.sk-bar-row{display:flex;align-items:center;gap:.8rem;}
.sk-bar-label{font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);width:70px;flex-shrink:0;}
.sk-bar-track{flex:1;height:2px;background:var(--muted2);border-radius:2px;overflow:hidden;}
.sk-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),rgba(184,255,87,.5));border-radius:2px;width:0;transition:width 1.2s cubic-bezier(.16,1,.3,1);}
.sk-bar-pct{font-size:.55rem;color:var(--accent);width:28px;text-align:right;flex-shrink:0;}

/* ══════════════════════════════════
   SECTION 4: TOOLS MARQUEE
══════════════════════════════════ */
#section-tools{border-top:1px solid var(--border);overflow:hidden;position:relative;background:var(--bg);}
.tools-label-row{max-width:1440px;margin:0 auto;padding:3rem 3rem 0;}
.tools-track{display:flex;animation:toolsTick 28s linear infinite;width:max-content;padding:1.5rem 0;}
.tools-track:hover{animation-play-state:paused;}
.tool-pill{display:flex;align-items:center;gap:.7rem;padding:1rem 2rem;border-right:1px solid var(--border);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);white-space:nowrap;transition:color .2s,background .2s;cursor:none;}
.tool-pill:hover{color:var(--text);background:var(--surface);}
.tool-dot{width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0;}
@keyframes toolsTick{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ══════════════════════════════════
   SECTION 5: TIMELINE — 3D HELIX SIDE
══════════════════════════════════ */
#section-timeline{border-top:1px solid var(--border);background:var(--surface);overflow:hidden;position:relative;}
#helix-canvas-wrap{position:absolute;left:0;top:0;bottom:0;width:380px;pointer-events:none;opacity:.5;}
#helix-canvas{width:100%;height:100%;}

.tl-content{position:relative;z-index:1;padding-left:420px;}
.timeline{display:flex;flex-direction:column;}
.t-item{
  display:grid;grid-template-columns:100px 1px 1fr;
  gap:0;align-items:start;padding:3.5rem 0;
  border-bottom:1px solid var(--border);
  transition:background .3s;
  position:relative;
}
.t-item:last-child{border-bottom:none;}
.t-item:hover{background:rgba(255,255,255,.01);}
.t-year{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;color:var(--accent);letter-spacing:.06em;padding-top:.1rem;}
.t-line{display:flex;flex-direction:column;align-items:center;}
.t-dot{width:10px;height:10px;border-radius:50%;background:var(--accent);flex-shrink:0;box-shadow:0 0 0 3px rgba(184,255,87,.12),0 0 16px rgba(184,255,87,.3);transition:box-shadow .3s;}
.t-item:hover .t-dot{box-shadow:0 0 0 6px rgba(184,255,87,.15),0 0 28px rgba(184,255,87,.5);}
.t-connector{width:1px;flex:1;background:linear-gradient(var(--border),transparent);min-height:40px;}
.t-item:last-child .t-connector{display:none;}
.t-content{padding-left:2.5rem;}
.t-badge{display:inline-block;font-size:.55rem;letter-spacing:.16em;text-transform:uppercase;background:rgba(184,255,87,.1);color:var(--accent);padding:.22rem .7rem;border-radius:2px;margin-bottom:1rem;}
.t-title{font-family:'Cabinet Grotesk',sans-serif;font-weight:900;font-size:1.1rem;letter-spacing:-.02em;margin-bottom:.7rem;transition:color .3s;}
.t-item:hover .t-title{color:var(--accent);}
.t-desc{font-size:.77rem;color:var(--muted);line-height:1.9;}

/* ══════════════════════════════════
   SECTION 6: CTA — ANIMATED BG
══════════════════════════════════ */
#section-cta{position:relative;border-top:1px solid var(--border);overflow:hidden;}
#cta-canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}
.cta-wrap{position:relative;z-index:1;max-width:1440px;margin:0 auto;padding:0 3rem 8rem;}
.cta-inner{
  border:1px solid var(--border);
  position:relative;overflow:hidden;
  display:flex;align-items:center;justify-content:space-between;
  gap:3rem;padding:5rem;
  transition:border-color .4s;
}
.cta-inner:hover{border-color:rgba(184,255,87,.15);}
.cta-bg-text{position:absolute;right:-1rem;bottom:-2rem;font-family:'Bebas Neue',sans-serif;font-size:14rem;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.03);pointer-events:none;line-height:1;}
.cta-h{font-family:'Bebas Neue',sans-serif;font-size:clamp(3rem,7vw,6.5rem);line-height:.88;letter-spacing:.02em;margin-bottom:1.2rem;}
.cta-h .g{color:var(--accent);}
.cta-sub{font-size:.82rem;color:var(--muted);line-height:1.9;max-width:380px;}
.btn-cta{display:inline-flex;align-items:center;gap:.8rem;font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#000;background:var(--accent);padding:1rem 2.5rem;text-decoration:none;transition:background .2s,transform .2s;white-space:nowrap;flex-shrink:0;}
.btn-cta:hover{background:#d4ff6e;transform:translateY(-2px);}

/* FOOTER */
footer{position:relative;z-index:1;border-top:1px solid var(--border);padding:2rem 3rem;max-width:1440px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;}
footer span{font-size:.68rem;color:var(--muted);letter-spacing:.08em;}

/* ANIMATIONS */
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
@keyframes bob{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(8px)}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* RESPONSIVE */
@media(max-width:1100px){.who-grid{grid-template-columns:1fr;}.who-left{border-right:none;border-bottom:1px solid var(--border);}.tl-content{padding-left:2rem;}#helix-canvas-wrap{display:none;}#skills-canvas-wrap{display:none;}}
@media(max-width:800px){.skills-3grid{grid-template-columns:1fr;}.cta-inner{flex-direction:column;align-items:flex-start;padding:3rem 2rem;}.hero-content{padding:0 1.5rem 4rem;}.s-wrap{padding:5rem 1.5rem;}.cta-wrap{padding:0 1.5rem 5rem;}.nav-links{display:none;}.ham{display:flex;}nav{padding:0 1.5rem;}}
@media(max-width:600px){.hero-content-inner{flex-direction:column;align-items:flex-start;gap:2rem;}.hero-right-meta{text-align:left;}}
</style>
</head>
