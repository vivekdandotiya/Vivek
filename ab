const cur=document.getElementById('cursor'),ring=document.getElementById('cursorRing');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;});
(function lp(){cur.style.left=mx+'px';cur.style.top=my+'px';rx+=(mx-rx)*.14;ry+=(my-ry)*.14;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(lp);})();
document.querySelectorAll('a,button,.sk-card').forEach(el=>{el.addEventListener('mouseenter',()=>{cur.classList.add('big');ring.classList.add('big');});el.addEventListener('mouseleave',()=>{cur.classList.remove('big');ring.classList.remove('big');});});

// MOBILE NAV
const ham=document.getElementById('ham'),mob=document.getElementById('mob');
ham.addEventListener('click',()=>{ham.classList.toggle('open');mob.classList.toggle('open');});
mob.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{ham.classList.remove('open');mob.classList.remove('open');}));

// ──────────────────────────────────────────────────────
// HERO CANVAS — THREE.JS FULL SCENE
// ──────────────────────────────────────────────────────
(function(){
  const canvas=document.getElementById('hero-canvas');
  let W=window.innerWidth,H=window.innerHeight;
  const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
  renderer.setSize(W,H);renderer.setPixelRatio(Math.min(devicePixelRatio,2));

  const scene=new THREE.Scene();
  const camera=new THREE.PerspectiveCamera(50,W/H,.1,200);
  camera.position.set(0,0,8);

  // Lights
  scene.add(new THREE.AmbientLight(0xffffff,.2));
  const al=new THREE.PointLight(0xb8ff57,4,20);al.position.set(3,3,4);scene.add(al);
  const bl=new THREE.PointLight(0x5c8aff,3,15);bl.position.set(-4,-1,3);scene.add(bl);
  const cl=new THREE.PointLight(0xff5ca8,2,12);cl.position.set(0,-4,2);scene.add(cl);

  // Central hero orb — layered
  const orbG=new THREE.SphereGeometry(1.4,64,64);
  const orbM=new THREE.MeshPhysicalMaterial({color:0x080c14,metalness:.95,roughness:.04,transparent:true,opacity:.9,side:THREE.DoubleSide});
  const orb=new THREE.Mesh(orbG,orbM);scene.add(orb);

  // Wireframe shell
  const wG=new THREE.IcosahedronGeometry(1.5,2);
  const wM=new THREE.MeshBasicMaterial({color:0xb8ff57,wireframe:true,transparent:true,opacity:.06});
  const wire=new THREE.Mesh(wG,wM);scene.add(wire);

  // Equator ring
  const rG=new THREE.TorusGeometry(2,0.012,3,120);
  const rM=new THREE.MeshBasicMaterial({color:0xb8ff57,transparent:true,opacity:.3});
  const ring1=new THREE.Mesh(rG,rM);ring1.rotation.x=Math.PI/2;scene.add(ring1);

  // Tilted ring
  const r2=new THREE.Mesh(new THREE.TorusGeometry(2.4,.008,3,120),new THREE.MeshBasicMaterial({color:0x5c8aff,transparent:true,opacity:.2}));
  r2.rotation.x=Math.PI/3;r2.rotation.y=.5;scene.add(r2);

  // Vertical ring
  const r3=new THREE.Mesh(new THREE.TorusGeometry(2.7,.007,3,120),new THREE.MeshBasicMaterial({color:0xff5ca8,transparent:true,opacity:.15}));
  r3.rotation.z=Math.PI/4;scene.add(r3);

  // Orbiting moons
  const moonG=new THREE.SphereGeometry(.14,12,12);
  const moons=[
    {mesh:new THREE.Mesh(moonG,new THREE.MeshBasicMaterial({color:0xb8ff57})),angle:0,r:2,speed:.6,tilt:0},
    {mesh:new THREE.Mesh(moonG,new THREE.MeshBasicMaterial({color:0x5c8aff})),angle:Math.PI*.66,r:2.4,speed:.4,tilt:.5},
    {mesh:new THREE.Mesh(moonG,new THREE.MeshBasicMaterial({color:0xff5ca8})),angle:Math.PI*1.33,r:2.7,speed:.3,tilt:.9},
  ];
  moons.forEach(m=>{m.mesh.material.transparent=true;m.mesh.material.opacity=.8;scene.add(m.mesh);});

  // Particle field
  const pc=300;const pg=new THREE.BufferGeometry();const pp=new Float32Array(pc*3);
  for(let i=0;i<pc;i++){pp[i*3]=(Math.random()-.5)*22;pp[i*3+1]=(Math.random()-.5)*22;pp[i*3+2]=(Math.random()-.5)*22;}
  pg.setAttribute('position',new THREE.BufferAttribute(pp,3));
  const particles=new THREE.Points(pg,new THREE.PointsMaterial({color:0xb8ff57,size:.028,transparent:true,opacity:.25}));
  scene.add(particles);

  // Floating tech text cubes (abstract)
  const cubeG=new THREE.BoxGeometry(.35,.35,.35);
  const cubes=[];
  for(let i=0;i<8;i++){
    const c=new THREE.Mesh(cubeG,new THREE.MeshBasicMaterial({color:[0xb8ff57,0x5c8aff,0xff5ca8][i%3],wireframe:true,transparent:true,opacity:.18}));
    c.position.set((Math.random()-.5)*12,(Math.random()-.5)*8,(Math.random()-.5)*6-2);
    c.userData={vx:(Math.random()-.5)*.01,vy:(Math.random()-.5)*.01,rx:Math.random()*.02,ry:Math.random()*.02};
    scene.add(c);cubes.push(c);
  }

  // Mouse parallax
  let tRX=0,tRY=0,cRX=0,cRY=0;
  document.addEventListener('mousemove',e=>{tRY=((e.clientX/W)-.5)*1.2;tRX=-((e.clientY/H)-.5)*.8;});

  let t=0;
  (function animate(){
    requestAnimationFrame(animate);t+=.007;
    cRX+=(tRX-cRX)*.04;cRY+=(tRY-cRY)*.04;

    orb.rotation.y=t*.25+cRY;orb.rotation.x=cRX*.5;
    wire.rotation.y=-t*.18;wire.rotation.x=t*.12;

    ring1.rotation.z=t*.15;
    r2.rotation.z=t*.1;r2.rotation.x=Math.PI/3+Math.sin(t*.3)*.1;
    r3.rotation.y=t*.08;

    moons.forEach(m=>{
      m.angle+=m.speed*.007;
      m.mesh.position.x=Math.cos(m.angle)*m.r;
      m.mesh.position.y=Math.sin(m.angle*.7+m.tilt)*.9;
      m.mesh.position.z=Math.sin(m.angle)*m.r*.5;
    });

    cubes.forEach(c=>{
      c.position.x+=c.userData.vx;c.position.y+=c.userData.vy;
      c.rotation.x+=c.userData.rx;c.rotation.y+=c.userData.ry;
      if(Math.abs(c.position.x)>7) c.userData.vx*=-1;
      if(Math.abs(c.position.y)>5) c.userData.vy*=-1;
    });

    particles.rotation.y=t*.018;particles.rotation.x=t*.009;
    al.intensity=3.5+Math.sin(t*1.8)*.8;
    bl.intensity=2.5+Math.cos(t*1.3)*.6;

    renderer.render(scene,camera);
  })();

  window.addEventListener('resize',()=>{
    W=window.innerWidth;H=window.innerHeight;
    camera.aspect=W/H;camera.updateProjectionMatrix();renderer.setSize(W,H);
  });
})();

// ──────────────────────────────────────────────────────
// SKILLS CANVAS — floating wireframe shapes
// ──────────────────────────────────────────────────────
(function(){
  const wrap=document.getElementById('skills-canvas-wrap');
  const canvas=document.getElementById('skills-canvas');
  if(!wrap||!canvas)return;
  function getSize(){ return {W:wrap.offsetWidth||420, H:Math.max(wrap.offsetHeight,document.getElementById('section-skills').offsetHeight)||600}; }
  let {W,H}=getSize();
  const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
  renderer.setSize(W,H);renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  const scene=new THREE.Scene();
  const camera=new THREE.PerspectiveCamera(60,W/H,.1,50);
  camera.position.z=5;
  scene.add(new THREE.AmbientLight(0xb8ff57,.4));

  const shapes=[];
  const geos=[
    new THREE.IcosahedronGeometry(.4,0),
    new THREE.OctahedronGeometry(.5,0),
    new THREE.TetrahedronGeometry(.5,0),
    new THREE.BoxGeometry(.5,.5,.5),
    new THREE.DodecahedronGeometry(.4,0),
  ];
  for(let i=0;i<12;i++){
    const g=geos[i%geos.length];
    const m=new THREE.MeshBasicMaterial({color:[0xb8ff57,0x5c8aff,0xff5ca8,0x57ffdb][i%4],wireframe:true,transparent:true,opacity:.2+Math.random()*.25});
    const mesh=new THREE.Mesh(g,m);
    mesh.position.set((Math.random()-.5)*5,(Math.random()-.5)*7,(Math.random()-.5)*3);
    mesh.userData={rx:(Math.random()-.5)*.025,ry:(Math.random()-.5)*.025,vy:(Math.random()-.5)*.008};
    scene.add(mesh);shapes.push(mesh);
  }
  let t=0;
  (function a(){requestAnimationFrame(a);t+=.008;
    shapes.forEach(s=>{s.rotation.x+=s.userData.rx;s.rotation.y+=s.userData.ry;s.position.y+=s.userData.vy;if(s.position.y>4)s.position.y=-4;if(s.position.y<-4)s.position.y=4;});
    renderer.render(scene,camera);
  })();
  window.addEventListener('resize',()=>{
    const s=getSize();
    camera.aspect=s.W/s.H;camera.updateProjectionMatrix();renderer.setSize(s.W,s.H);
  });
})();

// ──────────────────────────────────────────────────────
// HELIX CANVAS — DNA-like double helix
// ──────────────────────────────────────────────────────
(function(){
  const wrap=document.getElementById('helix-canvas-wrap');
  const canvas=document.getElementById('helix-canvas');
  if(!wrap||!canvas)return;
  const W=wrap.offsetWidth||380;
  const H=Math.max(document.getElementById('section-timeline').offsetHeight||600,600);
  const renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:true});
  renderer.setSize(W,H);renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  const scene=new THREE.Scene();
  const camera=new THREE.PerspectiveCamera(55,W/H,.1,50);
  camera.position.set(0,0,7);
  scene.add(new THREE.AmbientLight(0xffffff,.3));
  const aL=new THREE.PointLight(0xb8ff57,3,15);aL.position.set(3,0,4);scene.add(aL);
  const bL=new THREE.PointLight(0x5c8aff,2,12);bL.position.set(-3,0,3);scene.add(bL);

  const helixGroup=new THREE.Group();scene.add(helixGroup);
  const dotG=new THREE.SphereGeometry(.09,8,8);
  const N=28;
  for(let i=0;i<N;i++){
    const t_=i/N*Math.PI*4;
    const y=(i/N)*10-5;

    // Strand A
    const mA=new THREE.Mesh(dotG,new THREE.MeshBasicMaterial({color:0xb8ff57,transparent:true,opacity:.7}));
    mA.position.set(Math.cos(t_)*1.2,y,Math.sin(t_)*1.2);
    helixGroup.add(mA);

    // Strand B (opposite)
    const mB=new THREE.Mesh(dotG,new THREE.MeshBasicMaterial({color:0x5c8aff,transparent:true,opacity:.7}));
    mB.position.set(Math.cos(t_+Math.PI)*1.2,y,Math.sin(t_+Math.PI)*1.2);
    helixGroup.add(mB);

    // Rung connecting them
    if(i%3===0){
      const pts=[mA.position.clone(),mB.position.clone()];
      const rungG=new THREE.BufferGeometry().setFromPoints(pts);
      const rung=new THREE.Line(rungG,new THREE.LineBasicMaterial({color:0x2a2a40,transparent:true,opacity:.5}));
      helixGroup.add(rung);
    }
  }

  let t=0;
  (function a(){requestAnimationFrame(a);t+=.008;
    helixGroup.rotation.y=t*.4;
    aL.intensity=2.5+Math.sin(t*1.5)*.7;
    renderer.render(scene,camera);
  })();
})();

// ──────────────────────────────────────────────────────
// CTA CANVAS — flowing wave particles
// ──────────────────────────────────────────────────────
(function(){
  const canvas=document.getElementById('cta-canvas');
  if(!canvas)return;
  const section=document.getElementById('section-cta');
  function resize(){
    canvas.width=section.offsetWidth||window.innerWidth;
    canvas.height=section.offsetHeight||500;
  }
  resize();
  const ctx=canvas.getContext('2d');
  const pts=[];
  function initPts(){
    pts.length=0;
    for(let i=0;i<80;i++) pts.push({x:Math.random()*canvas.width,y:Math.random()*canvas.height,vx:(Math.random()-.5)*.4,vy:(Math.random()-.5)*.4,r:1+Math.random()*1.5});
  }
  initPts();
  let t=0;
  (function a(){requestAnimationFrame(a);t+=.012;
    const W=canvas.width,H=canvas.height;
    ctx.clearRect(0,0,W,H);
    pts.forEach(p=>{
      p.x+=p.vx+Math.sin(t+p.y*.01)*.3;
      p.y+=p.vy+Math.cos(t+p.x*.01)*.2;
      if(p.x<0)p.x=W;if(p.x>W)p.x=0;
      if(p.y<0)p.y=H;if(p.y>H)p.y=0;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle='rgba(184,255,87,.12)';ctx.fill();
    });
    for(let i=0;i<pts.length;i++) for(let j=i+1;j<pts.length;j++){
      const dx=pts[i].x-pts[j].x,dy=pts[i].y-pts[j].y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<100){ctx.beginPath();ctx.moveTo(pts[i].x,pts[i].y);ctx.lineTo(pts[j].x,pts[j].y);ctx.strokeStyle=`rgba(184,255,87,${(.08*(1-d/100)).toFixed(3)})`;ctx.lineWidth=.5;ctx.stroke();}
    }
  })();
  window.addEventListener('resize',()=>{resize();initPts();});
})();

// ──────────────────────────────────────────────────────
// SCROLL REVEAL + SKILL BARS
// ──────────────────────────────────────────────────────
const io=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add('visible');
      io.unobserve(e.target);
    }
  });
},{threshold:.08});
document.querySelectorAll('.reveal').forEach(r=>io.observe(r));

// Animate skill bars when section visible
const barObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('.sk-bar-fill').forEach((bar,i)=>{
        setTimeout(()=>bar.style.width=bar.dataset.w+'%',i*120+200);
      });
      barObs.unobserve(e.target);
    }
  });
},{threshold:.2});
document.querySelectorAll('.skills-3grid').forEach(g=>barObs.observe(g));

// 3D tilt on skill cards
document.querySelectorAll('.sk-card').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const r=card.getBoundingClientRect();
    const x=(e.clientX-r.left)/r.width-.5;
    const y=(e.clientY-r.top)/r.height-.5;
    card.style.transform=`perspective(600px) rotateY(${x*12}deg) rotateX(${-y*10}deg) translateZ(8px)`;
  });
  card.addEventListener('mouseleave',()=>card.style.transform='perspective(600px) rotateY(0) rotateX(0) translateZ(0)');
});
</script>
</body>
</html>