<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vivek Dandotiya — Web Designer & Developer</title>
<meta name="description" content="Vivek Dandotiya — Web Designer & Full Stack Developer creating clean, high-performance digital experiences and interactive web applications.">
<meta property="og:title" content="Vivek Dandotiya — Web Designer & Developer">
<meta property="og:description" content="Crafting clean, responsive, and high-performance digital experiences from India.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
:root{
  --grid-line: rgba(255, 255, 255, 0.095);
  --bg:#0a0a0a;
  --surface:#111111;
  --surface2:#161616;
  --border:#1f1f1f;
  --border2:#2a2a2a;
  --text:#ffffff;
  --text2:#a0a0a0;
  --text3:#555;
  --accent:#b8ff57;
  --red:#ff3333;
  --radius:16px;
}
html{scroll-behavior:smooth;}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;cursor:none;
  background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
  background-size: 120px 120px;}

/* CURSOR */
#cur{position:fixed;width:10px;height:10px;background:#fff;border-radius:50%;pointer-events:none;z-index:99999;transform:translate(-50%,-50%);transition:width .2s,height .2s,background .2s;}
#cur-ring{position:fixed;width:36px;height:36px;border:1px solid rgba(255,255,255,.3);border-radius:50%;pointer-events:none;z-index:99998;transform:translate(-50%,-50%);transition:width .35s,height .35s,border-color .3s;}
body:has(a:hover) #cur,body:has(button:hover) #cur{width:6px;height:6px;}
body:has(a:hover) #cur-ring,body:has(button:hover) #cur-ring{width:52px;height:52px;border-color:rgba(255,255,255,.6);}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:500;display:flex;align-items:center;justify-content:space-between;padding:0 2.5rem;height:64px;background:rgba(10,10,10,.8);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);}
.nav-brand{display:flex;align-items:center;gap:.8rem;}
.nav-logo{font-family:'Space Grotesk',sans-serif;font-size:1.3rem;font-weight:700;color:#fff;text-decoration:none;letter-spacing:-.02em;}
.nav-tagline{display:flex;flex-direction:column;line-height:1.1;}
.nav-tagline span{font-size:.52rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text3);}
.nav-tagline span.green{color:var(--accent);}
.nav-center{display:flex;align-items:center;gap:.25rem;background:var(--surface);border:1px solid var(--border2);border-radius:999px;padding:.3rem;}
.nav-center a{font-size:.78rem;padding:.45rem 1.1rem;border-radius:999px;color:var(--text2);text-decoration:none;transition:background .2s,color .2s;white-space:nowrap;}
.nav-center a:hover{color:#fff;}
.nav-center a.active{background:#fff;color:#000;font-weight:600;}
.nav-right{display:flex;align-items:center;gap:.6rem;}
.btn-hire{font-size:.78rem;font-weight:600;background:#fff;color:#000;padding:.5rem 1.2rem;border-radius:999px;text-decoration:none;transition:background .2s,transform .15s;}
.btn-hire:hover{background:#ddd;transform:translateY(-1px);}
.ham{display:none;flex-direction:column;gap:4px;cursor:none;background:none;border:none;padding:.5rem;}
.ham span{width:20px;height:1.5px;background:#fff;display:block;transition:all .3s;}
.mob-nav{position:fixed;inset:0;z-index:490;background:rgba(10,10,10,.98);backdrop-filter:blur(30px);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:2rem;transform:translateY(-100%);transition:transform .5s cubic-bezier(.16,1,.3,1);}
.mob-nav.open{transform:translateY(0);}
.mob-nav a{font-family:'Space Grotesk',sans-serif;font-size:3.5rem;font-weight:700;color:#fff;text-decoration:none;letter-spacing:-.03em;transition:color .2s;}
.mob-nav a:hover{color:var(--accent);}

/* HERO */
#hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:0 2rem;}
.hero-eyebrow{font-size:.7rem;letter-spacing:.25em;text-transform:uppercase;color:var(--text3);margin-bottom:1.5rem;opacity:0;animation:fadeUp .6s .3s forwards;}
.hero-name{font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(5rem,16vw,18rem);letter-spacing:-.05em;line-height:.88;text-align:center;opacity:0;animation:fadeUp .8s .4s forwards;}
.hero-name span {
  display: inline-block;
  color: transparent;
  -webkit-text-stroke: 1.5px transparent;
  transition: color 0.8s ease, -webkit-text-stroke 0.8s ease, opacity 0.8s ease;
  opacity: 0;
}
[data-theme='light'] .hero-name span {
  -webkit-text-stroke: 1.5px transparent;
}
.hero-name.filled span {
  color: var(--text) !important;
  -webkit-text-stroke: 1.5px transparent !important;
  opacity: 1 !important;
}
.hero-sub{display:flex;flex-direction:column;align-items:center;gap:.5rem;margin-top:2rem;opacity:0;animation:fadeUp .7s .6s forwards;}
.hero-sub .line1{font-size:clamp(.85rem,1.8vw,1.1rem);letter-spacing:.2em;text-transform:uppercase;color:var(--text2);}
.hero-sub .line2{font-family:'DM Serif Display',serif;font-style:italic;font-size:clamp(1.8rem,4vw,3.5rem);color:#fff;}
.hero-corners{position:absolute;inset:0;pointer-events:none;}
.hero-corner{position:absolute;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--text3);}
.hero-corner.bl{bottom:3rem;left:3rem;display:flex;flex-direction:column;gap:.3rem;}
.hero-corner.br{bottom:3rem;right:3rem;text-align:right;display:flex;flex-direction:column;gap:.3rem;}
.hero-corner strong{display:block;font-size:.78rem;color:#fff;font-weight:600;letter-spacing:.04em;}
.hero-scroll{position:absolute;bottom:3rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text3);animation:bob 2s ease infinite;}
.hero-scroll-line{width:1px;height:36px;background:linear-gradient(var(--text3),transparent);}

/* TICKER */
.ticker{overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface);padding:.85rem 0;}
.ticker-track{display:flex;width:max-content;animation:ticker 30s linear infinite;}
.ticker-item{display:flex;align-items:center;gap:.75rem;padding:0 2rem;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text2);white-space:nowrap;border-right:1px solid var(--border);}
.ticker-star{color:var(--accent);font-size:.9rem;}

/* BENTO GRID */
.bento{max-width:1380px;margin:0 auto;padding:4rem 2rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
.bento-card{background:var(--surface);border:1px solid var(--border2);border-radius:var(--radius);padding:2rem;position:relative;overflow:hidden;transition:border-color .3s,transform .3s;}
.bento-card:hover{border-color:var(--border2);transform:translateY(-2px);}
.bento-card.span2{grid-column:span 2;}
.bento-card.tall{min-height:360px;}
.bento-card.center-card{display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;}

/* Card: intro */
.card-intro .c-name{font-family:'Space Grotesk',sans-serif;font-size:1.8rem;font-weight:700;letter-spacing:-.03em;margin-bottom:.4rem;}
.card-intro .c-name em{font-family:'DM Serif Display',serif;font-weight:400;font-style:italic;color:var(--text2);}
.card-intro .c-loc{display:flex;align-items:center;gap:.4rem;font-size:.7rem;color:var(--text3);margin-bottom:1.5rem;}
.card-intro .c-photos{display:flex;gap:.5rem;margin-bottom:1.5rem;}
.card-intro .c-photo{width:80px;height:100px;border-radius:10px;background:var(--surface2);overflow:hidden;object-fit:cover;}
.card-intro .c-photo.placeholder{background:linear-gradient(135deg,#1a1a1a,#222);display:flex;align-items:center;justify-content:center;font-size:1.5rem;}
.card-intro .c-socials{display:flex;gap:1.2rem;}
.card-intro .c-socials a{color:var(--text3);text-decoration:none;font-size:.85rem;transition:color .2s;}
.card-intro .c-socials a:hover{color:#fff;}

/* Card: philosophy */
.card-phil .c-tag{display:inline-flex;align-items:center;gap:.4rem;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);border:1px solid var(--border2);padding:.3rem .8rem;border-radius:999px;margin-bottom:1.5rem;}
.card-phil .c-heading{font-size:2.2rem;font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:.5rem;}
.card-phil .c-heading em{font-family:'DM Serif Display',serif;font-weight:400;font-style:italic;color:var(--text2);}
.card-phil .c-desc{font-size:.82rem;color:var(--text2);line-height:1.8;margin-top:1rem;}
.card-phil .c-tabs{display:flex;gap:.5rem;margin-top:1.5rem;flex-wrap:wrap;}
.card-phil .c-tab{font-size:.7rem;border:1px solid var(--border2);padding:.3rem .85rem;border-radius:999px;color:var(--text2);cursor:none;transition:all .2s;}
.card-phil .c-tab.active{border-color:#fff;color:#fff;}

/* Card: CTA */
.card-cta .available{display:flex;align-items:center;gap:.5rem;font-size:.68rem;color:var(--accent);margin-bottom:1.5rem;}
.card-cta .available .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:glow-pulse 2s infinite;}
.card-cta .c-heading{font-size:1.6rem;font-weight:800;letter-spacing:-.03em;line-height:1.2;margin-bottom:.5rem;}
.card-cta .c-heading em{font-family:'DM Serif Display',serif;font-weight:400;font-style:italic;color:var(--text2);}
.card-cta .c-email{display:flex;align-items:center;gap:.6rem;font-family:'DM Serif Display',serif;font-style:italic;font-size:1.1rem;color:#fff;margin:1.5rem 0 .3rem;cursor:none;transition:color .2s;}
.card-cta .c-email:hover{color:var(--accent);}
.card-cta .c-copy-hint{font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);margin-bottom:1.5rem;}
.btn-connect{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.85rem;background:#fff;color:#000;border-radius:999px;font-size:.8rem;font-weight:700;letter-spacing:.05em;text-decoration:none;text-transform:uppercase;transition:background .2s,transform .15s;border:none;cursor:none;}
.btn-connect:hover{background:#ddd;transform:translateY(-1px);}

/* Card: skills */
.card-skills .c-eyebrow{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text3);margin-bottom:.8rem;}
.card-skills .c-heading{font-size:2rem;font-weight:800;letter-spacing:-.03em;line-height:1.1;margin-bottom:1.5rem;}
.card-skills .c-heading em{font-family:'DM Serif Display',serif;font-weight:400;font-style:italic;color:var(--accent);}
.skills-pills{display:flex;flex-wrap:wrap;gap:.5rem;}
.skill-pill{display:flex;align-items:center;gap:.4rem;background:var(--surface2);border:1px solid var(--border2);border-radius:999px;padding:.4rem 1rem;font-size:.72rem;color:var(--text2);transition:border-color .2s,color .2s;}
.skill-pill:hover{border-color:rgba(184,255,87,.4);color:var(--accent);}
.skill-pill span{font-size:.85rem;}

/* Card: projects preview */
.card-proj .c-heading{font-size:1.3rem;font-weight:800;letter-spacing:-.03em;margin-bottom:1rem;}
.proj-mini{display:flex;flex-direction:column;gap:.6rem;}
.proj-mini-item{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;background:var(--surface2);border:1px solid var(--border);border-radius:10px;text-decoration:none;color:#fff;transition:border-color .2s,background .2s;}
.proj-mini-item:hover{border-color:var(--border2);background:#1a1a1a;}
.proj-mini-item .pi-left{display:flex;align-items:center;gap:.8rem;}
.proj-mini-item .pi-icon{font-size:1.2rem;}
.proj-mini-item .pi-name{font-size:.8rem;font-weight:600;}
.proj-mini-item .pi-tags{font-size:.62rem;color:var(--text3);}
.proj-mini-item .pi-arrow{color:var(--text3);font-size:.85rem;transition:transform .2s,color .2s;}
.proj-mini-item:hover .pi-arrow{transform:translate(2px,-2px);color:#fff;}

/* Card: stats */
.card-stats{display:flex;flex-direction:column;justify-content:space-between;}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;flex:1;}
.stat-item{display:flex;flex-direction:column;gap:.3rem;}
.stat-n{font-family:'Space Grotesk',sans-serif;font-size:2.8rem;font-weight:700;letter-spacing:-.04em;color:#fff;line-height:1;}
.stat-l{font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);}

/* Card: quote/vibe */
.card-vibe{background:linear-gradient(135deg,#0f1a08,#111);border-color:rgba(184,255,87,.12);}
.card-vibe .vibe-quote{font-family:'DM Serif Display',serif;font-style:italic;font-size:1.5rem;line-height:1.5;color:#fff;margin-bottom:1.5rem;}
.card-vibe .vibe-attr{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:rgba(184,255,87,.5);}

/* SECTIONS */
.section{max-width:1380px;margin:0 auto;padding:5rem 2rem;}
.section-eyebrow{font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;color:var(--text3);margin-bottom:.8rem;}
.section-heading{font-size:clamp(2rem,5vw,4.5rem);font-weight:800;letter-spacing:-.04em;line-height:1;margin-bottom:3rem;}
.section-heading em{font-family:'DM Serif Display',serif;font-weight:400;font-style:italic;color:var(--accent);}

/* CTA SECTION */
.cta-section{text-align:center;padding:8rem 2rem;border-top:1px solid var(--border);}
.cta-section .big-text{font-family:'Inter',sans-serif;font-weight:900;font-size:clamp(3rem,10vw,9rem);letter-spacing:-.05em;line-height:.9;margin-bottom:2.5rem;}
.cta-section .big-text em{font-family:'DM Serif Display',serif;font-weight:400;font-style:italic;color:var(--accent);}
.cta-btns{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap;}

/* FLAME FOOTER DESIGN */
.footer-section {
  position: relative;
  background: #ffffff !important;
  color: #000000 !important;
  padding-top: 0;
  overflow: hidden;
  font-family: 'Inter', sans-serif;
  margin-top: 0;
}

.flame-divider-svg {
  width: 100%;
  height: 120px;
  display: block;
  background: var(--bg, #0a0a0a);
  fill: #ffffff;
}

.footer-main-content {
  padding: 4rem 4rem 2rem 4rem;
  display: flex;
  flex-direction: column;
  gap: 4rem;
  max-width: 1400px;
  margin: 0 auto;
}

.footer-cta-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.5rem;
}

.flame-mascot {
  width: 80px;
  height: 80px;
  background: #000000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.flame-mascot svg {
  width: 44px;
  height: 44px;
  fill: #ffffff;
}

.flame-heading {
  font-family: 'Space Grotesk', 'Inter', sans-serif;
  font-size: clamp(2rem, 4.5vw, 3.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.15;
  color: #000000 !important;
}

.btn-chat-cta {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #ffffff !important;
  background: #000000;
  padding: 1rem 2.8rem;
  border-radius: 999px;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  display: inline-block;
}

.btn-chat-cta:hover {
  transform: translateY(-3px) scale(1.03);
  background: #1a1a1a;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
}

.footer-links-grid {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 3rem;
  border-top: 1px solid rgba(0, 0, 0, 0.12);
}

.footer-nav-col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.footer-nav-title {
  font-family: 'Space Grotesk', monospace, sans-serif;
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #666666;
}

.footer-nav-list {
  display: flex;
  gap: 1.5rem;
  list-style: none;
  padding: 0;
  margin: 0;
  flex-wrap: wrap;
}

.footer-nav-list a {
  color: #000000 !important;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  transition: color 0.2s ease;
}

.footer-nav-list a:hover {
  color: #555555 !important;
}

.footer-social-list {
  display: flex;
  gap: 0.8rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.social-pill {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Space Grotesk', monospace, sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  color: #000000 !important;
  text-decoration: none;
  transition: all 0.25s ease;
}

.social-pill:hover {
  background: #000000;
  color: #ffffff !important;
}

.footer-watermark {
  font-family: 'Space Grotesk', 'Inter', sans-serif;
  font-size: clamp(4rem, 15vw, 16rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 0.8;
  color: rgba(0, 0, 0, 0.07) !important;
  text-align: center;
  user-select: none;
  pointer-events: none;
  margin-top: 2rem;
  text-transform: uppercase;
}

/* BUTTONS */
.btn-primary{display:inline-flex;align-items:center;gap:.5rem;background:#fff;color:#000;padding:.75rem 1.8rem;border-radius:999px;font-size:.8rem;font-weight:700;text-decoration:none;transition:background .2s,transform .15s;border:none;cursor:none;}
.btn-primary:hover{background:#ddd;transform:translateY(-1px);}
.btn-outline{display:inline-flex;align-items:center;gap:.5rem;border:1px solid var(--border2);color:#fff;padding:.75rem 1.8rem;border-radius:999px;font-size:.8rem;font-weight:600;text-decoration:none;transition:border-color .2s,background .2s;cursor:none;}
.btn-outline:hover{border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.05);}
.btn-accent{display:inline-flex;align-items:center;gap:.5rem;background:var(--accent);color:#000;padding:.75rem 1.8rem;border-radius:999px;font-size:.8rem;font-weight:700;text-decoration:none;transition:background .2s,transform .15s;border:none;cursor:none;}
.btn-accent:hover{background:#d0ff6e;transform:translateY(-1px);}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes bob{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(6px)}}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes glow-pulse{0%,100%{box-shadow:0 0 0 0 rgba(184,255,87,.4)}50%{box-shadow:0 0 0 8px rgba(184,255,87,0)}}
.reveal{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s ease;}
.reveal.in{opacity:1;transform:translateY(0);}

/* 3D GLOBE OVERLAY */
.globe-wrap{
  margin-bottom:1.5rem;
  display:flex;align-items:center;justify-content:flex-start;
  width:220px;height:220px;
  border-radius:50%;
  overflow:hidden;
  position:relative;
  cursor:pointer;
  box-shadow:inset 0 0 20px rgba(0,0,0,0.8), 0 0 30px rgba(184,255,87,0.1);
  transition:box-shadow .3s;
}
.globe-wrap:hover{
  box-shadow:inset 0 0 20px rgba(0,0,0,0.8), 0 0 40px rgba(184,255,87,0.3);
}
#globeViz{width:100%;height:100%;}
.globe-hint{
  position:absolute;bottom:10px;left:50%;transform:translateX(-50%);
  font-size:0.55rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text2);
  pointer-events:none;background:rgba(10,10,10,0.6);padding:0.2rem 0.5rem;border-radius:999px;
  backdrop-filter:blur(4px);
}

/* MAP OVERLAY (FULLSCREEN) */
#mapOverlay{
  position:fixed;inset:0;z-index:9000;
  background:var(--bg);
  display:flex;flex-direction:column;
  opacity:0;pointer-events:none;
  transition:opacity 1.2s ease;
}
#mapOverlay.active{
  opacity:1;pointer-events:all;
}
.map-header{
  position:absolute;top:0;left:0;right:0;z-index:9001;
  padding:1.5rem 2.5rem;display:flex;justify-content:space-between;align-items:center;
  background:linear-gradient(to bottom, rgba(10,10,10,0.9), transparent);
}
.map-title{font-family:'Space Grotesk',sans-serif;font-size:1.5rem;font-weight:700;}
.map-title em{font-family:'DM Serif Display',serif;font-weight:400;font-style:italic;color:var(--accent);}
.btn-back-globe{
  display:inline-flex;align-items:center;gap:0.5rem;
  background:rgba(10,10,10,0.8);border:1px solid var(--border2);
