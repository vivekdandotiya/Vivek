<!-- HERO NAME STRUCTURAL ASSEMBLY JELLY DROP-IN ANIMATION -->
<script>
(function() {
  const hero = document.getElementById('hero');
  const heroName = document.querySelector('.hero-name');
  const canvas = document.getElementById('hero-name-canvas');
  if (!canvas || !heroName) return;
  const ctx = canvas.getContext('2d');

  let width = 0;
  let height = 0;
  let letters = [];
  let sparks = [];
  let activeIndex = 0; // index of the letter currently assembling
  let activePart = 0;  // 0 = first half, 1 = second half
  let gravity = 0.35;  // smooth, steady drop speed
  let springK = 0.18;  // jelly jiggle stiffness
  let dampening = 0.78; // jelly jiggle dampening
  let isDone = false;

  const spansQuery = heroName.querySelectorAll('span');
  if (spansQuery.length === 0) return;

  // Initialize letters with two half-parts starting offscreen with jelly properties
  letters = Array.from(spansQuery).map(span => ({
    char: span.textContent,
    element: span,
    rect: { left: 0, top: 0, width: 0, height: 0 },
    parts: [
      { y: -150, vy: 0, status: 'waiting', scaleX: 1.0, scaleY: 1.0, scaleVY: 0 },
      { y: -150, vy: 0, status: 'waiting', scaleX: 1.0, scaleY: 1.0, scaleVY: 0 }
    ]
  }));

  function resize() {
    const heroRect = hero.getBoundingClientRect();
    width = canvas.width = heroRect.width;
    height = canvas.height = heroRect.height;

    letters.forEach(letter => {
      const rect = letter.element.getBoundingClientRect();
      letter.rect = {
        left: rect.left - heroRect.left,
        top: rect.top - heroRect.top,
        width: rect.width,
        height: rect.height
      };
    });
  }

  window.addEventListener('resize', resize);
  setTimeout(resize, 100);
  setTimeout(resize, 600);

  const offscreen = document.createElement('canvas');
  const offCtx = offscreen.getContext('2d');

  function drawLetterPart(letterObj, partIdx, currentY, themeColor) {
    const r = letterObj.rect;
    if (r.width === 0 || r.height === 0) return;
    const part = letterObj.parts[partIdx];

    offscreen.width = r.width;
    offscreen.height = r.height;
    offCtx.clearRect(0, 0, r.width, r.height);

    const style = getComputedStyle(letterObj.element);
    offCtx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    
    offCtx.fillStyle = '#ffffff';
    offCtx.textAlign = 'center';
    offCtx.textBaseline = 'middle';
    offCtx.fillText(letterObj.char, r.width / 2, r.height / 2);

    offCtx.globalCompositeOperation = 'source-in';
    offCtx.fillStyle = themeColor;
    offCtx.beginPath();

    // Define vertical/horizontal clipping mask for the two halves
    if (partIdx === 0) {
      if (letterObj.char === 'I') {
        offCtx.rect(0, 0, r.width, r.height / 2); // Top half for I
      } else {
        offCtx.rect(0, 0, r.width * 0.48, r.height); // Left half for V, E, K
      }
    } else {
      if (letterObj.char === 'I') {
        offCtx.rect(0, r.height / 2, r.width, r.height / 2); // Bottom half for I
      } else {
        offCtx.rect(r.width * 0.48, 0, r.width * 0.52, r.height); // Right half for V, E, K
      }
    }
    offCtx.fill();

    offCtx.globalCompositeOperation = 'source-over';

    // Scale organically relative to the bottom center of the letter part (squash & stretch origin)
    ctx.save();
    const originX = r.left + r.width / 2;
    const originY = currentY + r.height;
    ctx.translate(originX, originY);
    ctx.scale(part.scaleX, part.scaleY);
    ctx.drawImage(offscreen, -r.width / 2, -r.height);
    ctx.restore();
  }

  function spawnSparks(x, y, themeColor) {
    const count = Math.floor(Math.random() * 8) + 6;
    for (let i = 0; i < count; i++) {
      sparks.push({
        x: x,
        y: y,
        vx: (Math.random() - 0.5) * 4,
        vy: -Math.random() * 3 - 2,
        gravity: 0.15,
        size: Math.random() * 1.5 + 1.2,
        alpha: 1.0,
        fade: Math.random() * 0.04 + 0.03,
        color: themeColor
      });
    }
  }

  function animate() {
    if (isDone) return;
    
    ctx.clearRect(0, 0, width, height);

    const themeColor = getComputedStyle(document.body).getPropertyValue('--text').trim();

    // 1. Process active falling letter and parts
    if (activeIndex < letters.length) {
      const letter = letters[activeIndex];
      const part = letter.parts[activePart];

      if (part.status === 'waiting') {
        part.status = 'falling';
      }

      if (part.status === 'falling') {
        part.vy += gravity;
        part.y += part.vy;

        // Stretch vertically as velocity increases (falling stretch)
        part.scaleY = 1.0 + Math.min(0.35, part.vy * 0.025);
        part.scaleX = 1.0 - Math.min(0.22, part.vy * 0.015);

        // Collision with resting ground (span top position)
        if (part.y >= letter.rect.top) {
          part.y = letter.rect.top;
          part.vy = 0;

          // Trigger elastic squash
          part.scaleY = 0.5;   // Squashed down
          part.scaleX = 1.5;   // Stretched out wide
          part.scaleVY = 0.14;  // Spring bounce velocity
          part.status = 'jiggling';

          // Spawn impact sparks
          spawnSparks(letter.rect.left + (activePart === 0 ? letter.rect.width * 0.25 : letter.rect.width * 0.75), letter.rect.top + letter.rect.height, themeColor);
        }
      }

      if (part.status === 'jiggling') {
        part.y = letter.rect.top;

        // Spring wobble physics towards natural scale 1.0
        const force = (1.0 - part.scaleY) * springK;
        part.scaleVY += force;
        part.scaleVY *= dampening;
        part.scaleY += part.scaleVY;
        part.scaleX = 1.0 / part.scaleY; // area conservation

        // Settle condition
        if (Math.abs(part.scaleY - 1.0) < 0.008 && Math.abs(part.scaleVY) < 0.003) {
          part.status = 'settled';
          part.scaleY = 1.0;
          part.scaleX = 1.0;
          part.scaleVY = 0;

          // Move to next part or next letter
          activePart++;
          if (activePart >= 2) {
            activePart = 0;
            activeIndex++;
            if (activeIndex >= letters.length) {
              isDone = true;
              finishAnimation();
            }
          }
        }
      }
    }

    // 2. Draw all active and settled parts
    letters.forEach(letter => {
      letter.parts.forEach((part, partIdx) => {
        if (part.status !== 'waiting') {
          drawLetterPart(letter, partIdx, part.y, themeColor);
        }
      });
    });

    // 3. Update & Draw Sparks
    for (let i = sparks.length - 1; i >= 0; i--) {
      const s = sparks[i];
      s.vy += s.gravity;
      s.x += s.vx;
      s.y += s.vy;
      s.alpha -= s.fade;

      if (s.alpha <= 0) {
        sparks.splice(i, 1);
        continue;
      }

      ctx.save();
      ctx.globalAlpha = s.alpha;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
      ctx.fillStyle = s.color;
      ctx.fill();
      ctx.restore();
    }

    requestAnimationFrame(animate);
  }

  function finishAnimation() {
    heroName.classList.add('filled');
    canvas.style.transition = 'opacity 1.2s ease';
    canvas.style.opacity = '0';
    setTimeout(() => {
      ctx.clearRect(0, 0, width, height);
    }, 1200);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      resize();
      requestAnimationFrame(animate);
    });
  } else {
    resize();
    requestAnimationFrame(animate);
  }
})();
</script>

